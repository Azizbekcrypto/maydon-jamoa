# Nusxa oling: .env.example -> .env. .env repo'ga yuklanmaydi (.gitignore).
# Bu fayldagi qiymatlar — NAMUNA, faqat laptopda sinash uchun. Render'da o'zingizning qiymatlaringiz yoziladi.

# Database ulanish qatori. Laptopdagi PostgreSQL namunasi (localhost:5432, baza maydon_jamoa).
# Neon'da: loyihangiz -> Connect -> connection string (oxiridagi ?sslmode=require qoladi)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maydon_jamoa

# Tokenni imzolaydigan uzun tasodifiy qator (maxfiy kalit). NAMUNA — internetda boshqasini yozing.
# Yo'q bo'lsa Backend ishga tushmaydi (kodda zaxira qiymat yo'q)
JWT_SECRET=namuna-jwt-kalit-faqat-laptop-uchun-almashtiring

# Brauzerdan so'rov va socket.io ulanishiga ruxsat (CORS). Web-trekda — sayt manzili; mobil trekda — ilovaning
# brauzer ko'rinishi manzili (12-Modul 7-dars), masalan https://maydon-jamoa-ilova.netlify.app (oxirida / siz).
# Telefondagi ilovaga (Expo Go, APK) kerak emas. Laptopda sinash uchun bo'sh qoldirish mumkin
WEB_ORIGIN=

# Port. Laptopda 3000; Render PORT ni o'zi beradi — u yerda yozilmaydi
PORT=3000
