# Nusxa oling: .env.example -> .env. .env repo'ga yuklanmaydi (.gitignore).
# Bu fayldagi qiymatlar — NAMUNA, faqat laptopda sinash uchun. Render'da o'zingizning qiymatlaringiz yoziladi.

# Database ulanish qatori. Laptopdagi PostgreSQL namunasi (localhost:5432, baza maydon_jamoa).
# Neon'da: loyihangiz -> Connect -> connection string (oxiridagi ?sslmode=require qoladi)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maydon_jamoa

# Tokenni imzolaydigan uzun tasodifiy qator (maxfiy kalit). NAMUNA — internetda boshqasini yozing.
# Yo'q bo'lsa Backend ishga tushmaydi (kodda zaxira qiymat yo'q)
JWT_SECRET=namuna-jwt-kalit-faqat-laptop-uchun-almashtiring

# Brauzerdan so'rov va socket.io ulanishiga ruxsat (CORS), bir nechta manzil — vergul bilan (oxirida / siz).
# Web-trekda — sayt manzili; mobil trekda — ilovaning brauzer ko'rinishi (7-dars) va lending — sanoq sahifasi uchun (8-dars).
# Telefondagi ilovaga (Expo Go, APK) kerak emas. NAMUNA — laptopdagi manzillar (npx expo start --web va lending papkasi serveri):
WEB_ORIGIN=http://localhost:8081,http://localhost:5500

# Sanoq sahifasining maxfiy kaliti (lending/sanoq.html, GET /hodisalar/sanoq). NAMUNA — internetda o'zingiz o'ylagan
# uzun kalit (harf va raqamlar; boshqa joydagi parolingiz emas). Kodga, chatga va repo'ga yozilmaydi
SANOQ_KALITI=namunasanoqkaliti123

# To'lov xabarining maxfiy kaliti (13-Modul 3-dars): «Mashq to'lov» sahifasi xabarni shu kalit bilan imzolaydi (HMAC SHA-256),
# POST /tolov/webhook imzoni shu kalit bilan tekshiradi. Bo'sh bo'lsa — hech bir to'lov xabari qabul qilinmaydi (401).
# Qiymat repo'ga, agentga va chatga yozilmaydi: .env ga va Render'ga o'zingiz qo'yasiz. Laptop uchun ham tasodifiy kalit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOLOV_KALITI=

# Port. Laptopda 3000; Render PORT ni o'zi beradi — u yerda yozilmaydi
PORT=3000

# RENDER_EXTERNAL_URL — Render o'zi beradi (xizmatning ochiq manzili), bu yerga yozilmaydi.
# Mashq to'lov sahifasi xabarni shu manzildagi POST /tolov/webhook ga yuboradi; laptopda — http://localhost:PORT
