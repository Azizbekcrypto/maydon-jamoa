# Nusxa oling: .env.example -> .env. .env repo'ga yuklanmaydi (.gitignore).
# EXPO_PUBLIC_ bilan boshlangan qiymat ilova ichiga OCHIQ matn bo'lib yoziladi — bu yerga maxfiy kalit yozilmaydi
# (JWT_SECRET, DATABASE_URL — faqat backend/.env da va Render'da).

# Backend manzili (oxirida / siz). NAMUNA: laptopning Wi-Fi'dagi manzili (telefon va laptop bitta Wi-Fi'da,
# Backend laptopda: cd backend, npm run start:dev). localhost yozilmaydi — telefon uchun localhost — telefonning o'zi.
# Internetdagi Backend: https://maydon-jamoa-….onrender.com
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
